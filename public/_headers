# Workers static assets apply these to what env.ASSETS.fetch() returns.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://appscope.glauser.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://appscope.glauser.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite fingerprints everything under /assets/, so it can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is revalidated, so a deploy is picked up on the next visit.
/
  Cache-Control: public, max-age=0, must-revalidate
